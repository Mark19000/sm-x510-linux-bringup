# Configuración mínima para initramfs/rootfs/init.
# KCONFIG_ALLCONFIG aplica estas peticiones sobre `allnoconfig`; Kconfig añade
# automáticamente las dependencias internas necesarias.
CONFIG_STATIC=y
CONFIG_BUSYBOX=y
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_TAB_COMPLETION=y

CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y

CONFIG_CAT=y
CONFIG_DD=y
CONFIG_HEAD=y
CONFIG_LN=y
CONFIG_LS=y
CONFIG_MKDIR=y
CONFIG_SLEEP=y
CONFIG_UNAME=y
CONFIG_SED=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_RM=y
CONFIG_RMDIR=y

CONFIG_DEPMOD=y
CONFIG_MODPROBE=y
CONFIG_BLKID=y
CONFIG_DMESG=y
CONFIG_HEXDUMP=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_SETSID=y
CONFIG_SWITCH_ROOT=y
CONFIG_HOSTNAME=y

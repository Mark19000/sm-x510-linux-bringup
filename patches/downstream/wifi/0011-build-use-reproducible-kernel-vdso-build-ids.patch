From 0000000000000000000000000000000000000011 Mon Sep 17 00:00:00 2001
From: gts9fe bring-up <gts9fe-student@localhost>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] build: use reproducible kernel and vDSO build IDs

Two clean U11 builds produced byte-identical modules, device trees, symbol
maps and configuration, but their Images differed in exactly two 20-byte
ranges: the compat vDSO build ID and the top-level vmlinux build ID.

LLD's sha1 build ID includes non-loadable linker/LTO material whose ordering
is not stable in this vendor tree.  Give the three loadable images distinct,
recipe-versioned IDs instead.  Module build IDs remain content-derived and
were already reproducible.

These identifiers are debugging labels, not integrity claims.  Provenance is
provided separately by the patch/config/source manifests in the dist tree.
---
 Makefile                          | 2 +-
 arch/arm64/kernel/vdso/Makefile   | 2 +-
 arch/arm64/kernel/vdso32/Makefile | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index 000000000000..111111111111 100644
--- a/Makefile
+++ b/Makefile
@@ -1123,7 +1123,7 @@ KBUILD_AFLAGS   += $(KAFLAGS)
 KBUILD_CFLAGS   += $(KCFLAGS)
 
 KBUILD_LDFLAGS_MODULE += --build-id=sha1
-LDFLAGS_vmlinux += --build-id=sha1
+LDFLAGS_vmlinux += --build-id=0x57058a4418ab06afd938fd0e9e8cb64a2d5d3933
 
 KBUILD_LDFLAGS	+= -z noexecstack
 ifeq ($(CONFIG_LD_IS_BFD),y)
diff --git a/arch/arm64/kernel/vdso/Makefile b/arch/arm64/kernel/vdso/Makefile
index 000000000000..111111111111 100644
--- a/arch/arm64/kernel/vdso/Makefile
+++ b/arch/arm64/kernel/vdso/Makefile
@@ -24,7 +24,7 @@ btildflags-$(CONFIG_ARM64_BTI_KERNEL) += -z force-bti
 # routines, as x86 does (see 6f121e548f83 ("x86, vdso: Reimplement vdso.so
 # preparation in build-time C")).
 ldflags-y := -shared -nostdlib -soname=linux-vdso.so.1 --hash-style=sysv	\
-	     -Bsymbolic --build-id=sha1 -n $(btildflags-y) -T
+	     -Bsymbolic --build-id=0x49cfa25babcb893702da3c382a03fe6a58c52915 -n $(btildflags-y) -T
 
 ccflags-y := -fno-common -fno-builtin -fno-stack-protector -ffixed-x18
 ccflags-y += -DDISABLE_BRANCH_PROFILING -DBUILD_VDSO
diff --git a/arch/arm64/kernel/vdso32/Makefile b/arch/arm64/kernel/vdso32/Makefile
index 000000000000..111111111111 100644
--- a/arch/arm64/kernel/vdso32/Makefile
+++ b/arch/arm64/kernel/vdso32/Makefile
@@ -116,7 +116,7 @@ VDSO_AFLAGS += $(dmbinstr)
 # From arm vDSO Makefile
 VDSO_LDFLAGS += -Bsymbolic --no-undefined -soname=linux-vdso.so.1
 VDSO_LDFLAGS += -z max-page-size=4096 -z common-page-size=4096
-VDSO_LDFLAGS += -nostdlib -shared --hash-style=sysv --build-id=sha1
+VDSO_LDFLAGS += -nostdlib -shared --hash-style=sysv --build-id=0x6f8c2ce3d766f486c5868124814b838d6496e533
 
 
 # Borrow vdsomunge.c from the arm vDSO
-- 

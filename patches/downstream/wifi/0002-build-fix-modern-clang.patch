From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: Tab S9 FE Linux Project <noreply@example.invalid>
Date: Sat, 22 Aug 2026 12:10:00 +0200
Subject: [PATCH] ANDROID: fix C declarations rejected by modern Clang

The Samsung Android 14 source was built with an older Android Clang.  Newer
Clang releases reject an implicit-int declaration, old-style empty parameter
lists, and an object passed through a const pointer before initialization.

Make the intended types explicit without changing runtime behaviour.

Signed-off-by: Tab S9 FE Linux Project <noreply@example.invalid>
---
 arch/arm64/kvm/sys_regs.c    | 2 +-
 kernel/sched/ems/sysbusy.c   | 2 +-
 mm/filemap.c                 | 4 ++--
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/kvm/sys_regs.c b/arch/arm64/kvm/sys_regs.c
--- a/arch/arm64/kvm/sys_regs.c
+++ b/arch/arm64/kvm/sys_regs.c
@@ -2784,6 +2784,6 @@ void kvm_sys_reg_table_init(void)
 {
 	unsigned int i;
-	struct sys_reg_desc clidr;
+	struct sys_reg_desc clidr = { 0 };
 
 	/* Make sure tables are unique and in order. */
 	BUG_ON(check_sysreg_table(sys_reg_descs, ARRAY_SIZE(sys_reg_descs), false));
diff --git a/kernel/sched/ems/sysbusy.c b/kernel/sched/ems/sysbusy.c
--- a/kernel/sched/ems/sysbusy.c
+++ b/kernel/sched/ems/sysbusy.c
@@ -40,7 +40,7 @@ struct sysbusy_stat {
 	u64 time_in_state;
 } sysbusy_stats[NUM_OF_SYSBUSY_STATE];
 
-static cpn_next_cpu[VENDOR_NR_CPUS] = { [0 ... VENDOR_NR_CPUS - 1] = -1 };
+static int cpn_next_cpu[VENDOR_NR_CPUS] = { [0 ... VENDOR_NR_CPUS - 1] = -1 };
 /******************************************************************************
  * sysbusy notify                                                             *
  ******************************************************************************/
diff --git a/mm/filemap.c b/mm/filemap.c
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -2978,14 +2978,14 @@ static void filemap_tracing_mark_begin(struct file *file,
 	tracing_mark_begin("%d , %s , %lu , %d", sync, path, offset, size);
 }
 
-static void filemap_tracing_mark_end()
+static void filemap_tracing_mark_end(void)
 {
     tracing_mark_end();
 }
 #else
 static void filemap_tracing_mark_begin(struct file *file,
 		pgoff_t offset, unsigned int size, bool sync) { }
-static void filemap_tracing_mark_end() { }
+static void filemap_tracing_mark_end(void) { }
 #endif
 
 #if CONFIG_MMAP_READAROUND_LIMIT == 0
-- 
2.50.1
